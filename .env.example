# The values below are the LOCAL DEVELOPMENT / INTERNAL DEMO defaults: LAN
# addresses over plain HTTP, reachable only from the same Wi-Fi as this
# machine. They are correct for `npx expo start` and for the internal demo APK
# (docs/android-local-demo.md), and WRONG for anything installed on a device
# outside this network.
#
# Building for external distribution: read docs/release-readiness-android.md
# and run `npm run release:preflight` first. It refuses a build pointed at
# localhost, a LAN address, or any non-HTTPS backend, and refuses the demo /
# mock / QA-fixture flags outright.
#
# Nothing here is a secret, and nothing here may become one. Every
# EXPO_PUBLIC_* value is inlined into the JavaScript bundle at build time and
# ships inside the APK, readable by anyone who unpacks it - which is why only
# public identifiers (OAuth CLIENT ids, ad unit ids, base URLs) belong in this
# file. Never put an API key, a client SECRET, or a token in an EXPO_PUBLIC_*
# variable.

# Base URL of the local media server serving company drama videos for dev/testing.
# See README.md "Local Company Video Playback" for setup steps.
EXPO_PUBLIC_MEDIA_BASE_URL=http://YOUR_MAC_LOCAL_IP:8000

# Base URL of the NestJS backend (see README.md "Mobile-to-Backend Setup").
EXPO_PUBLIC_API_BASE_URL=http://YOUR_MAC_IP:3000

# Set to "true" to force the app to use bundled mock data instead of the
# backend, even if EXPO_PUBLIC_API_BASE_URL is set.
EXPO_PUBLIC_USE_MOCK_DATA=false

# Set to "true" to build the OFFLINE SHOWCASE APK - the artifact handed to
# founders and partners who have no backend, no LAN and no account. This is
# the single switch for that build (src/services/demo/demo-mode.ts); it
# defaults to false everywhere, including CI and QA.
#
# What it changes, and where:
#   - bundled clips instead of a backend feed  (services/videos/video-service.ts)
#   - local login that accepts anything        (stores/auth.tsx, services/demo/demo-auth.ts)
#   - ads suppressed                           (services/ads/ads-config-service.ts)
#   - likes/saves stay local, queue never flushes (stores/video-interactions.tsx)
#   - Rewards resolves to its bounded "belum dibuka" state instead of a
#     request that cannot succeed              (features/rewards/use-rewards-center.ts)
#
# It implies mock data, so EXPO_PUBLIC_USE_MOCK_DATA does NOT also need
# setting. Leave EXPO_PUBLIC_API_BASE_URL UNSET for a demo build: the
# cleartext plugin then registers no exemption at all, and a stray request
# fails fast instead of hanging on a host that resolves but never answers.
#
# NOTE: this is a DIFFERENT artifact from the LAN-backed demo APK described
# in docs/android-local-demo.md, which requires this to stay false. See
# docs/android-offline-demo-apk.md.
EXPO_PUBLIC_DEMO_MODE=false

# Production AdMob interstitial ad unit IDs (Phase 15, slice 15A-S1). Leave
# unset for local dev/testing: `src/services/ads/interstitial-adapter.ts`
# falls back to Google's published TestIds.INTERSTITIAL whenever __DEV__ is
# true OR either of these is unset. NEVER put a real production unit ID in
# committed source - only ever set these locally / in build secrets.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_IOS=

# Slice 11R (mobile AUTO adaptive HLS playback) HLS playback enable/disable
# flag (a kill switch - NOT a prefer-MP4 fallback: an HLS-ready video has no
# client-side MP4 to fall back to). Defaults to HLS ENABLED when unset - set
# to "false" to DISABLE HLS playback: an HLS-shaped authorization then
# resolves to the existing "Video unavailable" state instead of playing,
# while every legacy/MP4 video is unaffected. No remote config.
EXPO_PUBLIC_HLS_PLAYBACK_ENABLED=true

# Mobile UI revision (2026-08-12): set to "true" to append synthetic QA-only
# fixtures (the 16:9 fullscreen sample) to the bundled mock catalog when
# EXPO_PUBLIC_USE_MOCK_DATA=true. Local fullscreen QA only - NEVER set this
# in demo/showcase or production builds.
EXPO_PUBLIC_INCLUDE_QA_FIXTURES=false

# Public legal pages, linked from Profile. UNSET by default, and unset today.
#
# Google Play requires a privacy policy URL in the store listing for any app
# that collects account data or serves ads (this app does both), and a web
# account-deletion page reachable WITHOUT installing the app - even though the
# app also offers in-app deletion.
#
# Nothing here may be guessed: a link that 404s is worse than no link, and a
# fabricated URL in a store listing is a policy problem. Every Profile row is
# rendered only for the URL a build actually has (src/constants/legal.ts), and
# `npm run release:preflight` blocks external distribution while the privacy
# policy URL is missing. Must be absolute https.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=

# WhatsApp OTP sign-in entry point. Defaults OFF, and V1 ships it off.
#
# This is NOT a feature flag for unfinished client work - the WhatsApp login
# screen, its OTP flow and its error handling are complete and tested. It is a
# gate on OFFERING the method, because the backend cannot serve it: per
# docs/api-contract.md ("Provider activation status"), WhatsApp auth "CANNOT be
# enabled in production - only a `fake` driver exists and the process refuses to
# boot with WhatsApp enabled outside development/test". A deployed server
# answers every request with 503 WHATSAPP_AUTH_DISABLED.
#
# Set to "true" only once a real WhatsApp Business provider is wired up on the
# backend AND that deployment has it enabled. See
# src/services/auth/provider-availability.ts.
EXPO_PUBLIC_WHATSAPP_AUTH_ENABLED=false

# Google Sign-In (Phase 10B). These are OAuth CLIENT IDs - public
# identifiers that ship inside every app binary by design, NOT secrets - but
# they are project-specific, so they live here rather than in committed
# source. Get them from your Google Cloud / Firebase project.
#
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID is the one that matters: Google issues the
# ID token this app exchanges with its own backend against the WEB client, on
# both Android and iOS. With it unset, the Google button reports a clear
# "not configured" message instead of failing mysteriously
# (src/services/auth/google-sign-in-contract.ts).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only. Required in addition to the web client ID when running on iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS only, and read at BUILD time (app.config.js), not runtime: the reversed
# iOS client ID, e.g. com.googleusercontent.apps.123456789-abcdef. When unset,
# the Google Sign-In config plugin is skipped entirely - Android still works,
# iOS does not - and `npx expo prebuild` prints why. Must be set BEFORE
# prebuilding for iOS.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
