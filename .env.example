# Base URL of the local media server serving company drama videos for dev/testing.
# See README.md "Local Company Video Playback" for setup steps.
EXPO_PUBLIC_MEDIA_BASE_URL=http://YOUR_MAC_LOCAL_IP:8000

# Base URL of the NestJS backend (see README.md "Mobile-to-Backend Setup").
EXPO_PUBLIC_API_BASE_URL=http://YOUR_MAC_IP:3000

# Set to "true" to force the app to use bundled mock data instead of the
# backend, even if EXPO_PUBLIC_API_BASE_URL is set.
EXPO_PUBLIC_USE_MOCK_DATA=false

# Production AdMob interstitial ad unit IDs (Phase 15, slice 15A-S1). Leave
# unset for local dev/testing: `src/services/ads/interstitial-adapter.ts`
# falls back to Google's published TestIds.INTERSTITIAL whenever __DEV__ is
# true OR either of these is unset. NEVER put a real production unit ID in
# committed source - only ever set these locally / in build secrets.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_IOS=

# Slice 11R (mobile AUTO adaptive HLS playback) HLS playback enable/disable
# flag (a kill switch - NOT a prefer-MP4 fallback: an HLS-ready video has no
# client-side MP4 to fall back to). Defaults to HLS ENABLED when unset - set
# to "false" to DISABLE HLS playback: an HLS-shaped authorization then
# resolves to the existing "Video unavailable" state instead of playing,
# while every legacy/MP4 video is unaffected. No remote config.
EXPO_PUBLIC_HLS_PLAYBACK_ENABLED=true

# Mobile UI revision (2026-08-12): set to "true" to append synthetic QA-only
# fixtures (the 16:9 fullscreen sample) to the bundled mock catalog when
# EXPO_PUBLIC_USE_MOCK_DATA=true. Local fullscreen QA only - NEVER set this
# in demo/showcase or production builds.
EXPO_PUBLIC_INCLUDE_QA_FIXTURES=false

# Google Sign-In (Phase 10B). These are OAuth CLIENT IDs - public
# identifiers that ship inside every app binary by design, NOT secrets - but
# they are project-specific, so they live here rather than in committed
# source. Get them from your Google Cloud / Firebase project.
#
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID is the one that matters: Google issues the
# ID token this app exchanges with its own backend against the WEB client, on
# both Android and iOS. With it unset, the Google button reports a clear
# "not configured" message instead of failing mysteriously
# (src/services/auth/google-sign-in-contract.ts).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only. Required in addition to the web client ID when running on iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS only, and read at BUILD time (app.config.js), not runtime: the reversed
# iOS client ID, e.g. com.googleusercontent.apps.123456789-abcdef. When unset,
# the Google Sign-In config plugin is skipped entirely - Android still works,
# iOS does not - and `npx expo prebuild` prints why. Must be set BEFORE
# prebuilding for iOS.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
