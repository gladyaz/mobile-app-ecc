# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Signing and service credentials. Listed BEFORE any of them exists on
# purpose: an upload keystore and its password file are the two artifacts a
# release adds to a working tree, and the moment to make them unstageable is
# before someone is holding one. `android/` is already ignored wholesale, but
# a keystore is routinely kept at the repository root or beside eas.json.
keystore.properties
upload-keystore.properties
google-services.json
GoogleService-Info.plist
play-service-account*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.env.ios-backup

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Demo showcase clips. Regenerated with the ffmpeg command in the demo
# commit message; kept out of history because they are ~62 MB of binary.
assets/videos/
assets/thumbnails/
